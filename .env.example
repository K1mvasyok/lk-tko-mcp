# Скопируй в .env и заполни реальными значениями.
# .env не коммитится (см. .gitignore) — здесь только пример структуры.
#
# По умолчанию указывай ЛОКАЛЬНЫЙ dev-инстанс lk-tko-v2
# (например, http://localhost:8080, как в curls.txt репозитория lk-tko-v2).
# Staging (lkul-irk-stage и т.п.) использовать только если явно
# убедился, что там нет чувствительных персональных данных.
#
# Где брать значения — см. ONBOARDING.md.

LK_REST_BASE_URL=http://localhost:8080
LK_REST_CLIENT_ID=
LK_REST_CLIENT_SECRET=
LK_USERNAME=
LK_PASSWORD=
